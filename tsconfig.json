{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": false,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.svelte",
		"vite.config.ts",
		"main.ts",
		"main.ts",
		"main.ts",
		"main.ts"
	]
}
