{
	"name": "ryanbmarx-portfolio",
	"version": "1.0.0",
	"type": "module",
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"html-minifier": "^4.0.0",
		"image-size": "^1.0.0",
		"jsonschema": "^1.4.1",
		"lodash.throttle": "^4.1.1",
		"marked": "^4.2.3",
		"npm-run-all": "^4.1.5",
		"svelte": "^5.0.0",
		"svg-sprite": "^2.0.2",
		"vite": "^6.0.0",
		"vitest": "^3.0.0"
	},
	"dependencies": {
		"sirv-cli": "^1.0.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "npm run svg && npm run ssr && vite build",
		"preview": "vite preview",
		"static": "mkdir -p ./public && cp -rf src/static/* public/",
		"publish": "cp -rf src/static/* .",
		"svg": "svg-sprite --config svg.config.json src/svg/**/*.svg",
		"ssr": "node ./src/functions/ssr.js",
		"test": "vitest run"
	},
	"browserslist": "> 0.25%, not dead"
}
