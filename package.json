{
	"name": "ryanbmarx-portfolio",
	"version": "1.0.0",
	"type": "module",
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"prettier": "^3.0.0",
		"prettier-plugin-svelte": "^3.0.0",
		"html-minifier": "^4.0.0",
		"image-size": "^1.0.0",
		"jsonschema": "^1.4.1",
		"lodash.throttle": "^4.1.1",
		"marked": "^15.0.0",
		"npm-run-all": "^4.1.5",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svg-sprite": "^2.0.2",
		"@types/node": "^22.0.0",
		"typescript": "^5.0.0",
		"vite": "^6.0.0",
		"vitest": "^3.0.0"
	},
	"dependencies": {
		"sirv-cli": "^1.0.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "npm run svg && npm run ssr && vite build",
		"preview": "vite preview",
		"static": "mkdir -p ./public && cp -rf src/static/* public/",
		"publish": "cp -rf src/static/* .",
		"svg": "svg-sprite --config svg.config.json src/svg/**/*.svg",
		"ssr": "node ./src/functions/ssr.js",
		"test": "vitest run",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"browserslist": "> 0.25%, not dead"
}
